{
  "name": "ipfs-splitwise-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "dev:splitwise": "npm run dev --workspace=p2p-splitwise",
    "dev:bookmarks": "npm run dev --workspace=p2p-bookmarks"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3"
  }
}
